rules_version = '2';

// Only the accounts listed below can read or change the family's expenses.
// Accounts are created by the family admin in Firebase (Authentication → Users → Add user),
// and self sign-up is turned off, so nobody else can create an account for these emails.
// To add someone: create their account, add their email (lowercase) below, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'password')
        && request.auth.token.email.lower() in [
          'dexterp0223@gmail.com',
          'jadexedric@yahoo.com'
        ];
    }

    match /{document=**} {
      allow read, write: if isFamily();
    }
  }
}
