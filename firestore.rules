rules_version = '2';

// Only the Google accounts listed below can read or change the family's expenses.
// To add someone: add their Gmail address (lowercase) to the list, then click Publish in Firebase.
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'dexterp0223@gmail.com',
          'add.family.member@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if isFamily();
    }
  }
}
